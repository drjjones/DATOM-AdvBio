---
import Layout from '../layouts/Layout.astro';
import { units, course, chaptersFor } from '../lib/content';
import { url } from '../lib/url';
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const chapterLabel = (u: (typeof units)[number]) => {
  const chs = chaptersFor(u).map((c) => c.number);
  return chs.length ? `Mader ch. ${chs.join(', ')}` : '';
};
---
<Layout title="Advanced Biology" description={`Interactive teaching site for Advanced Biology at ${course.school}: ten units, fifty standards, every one built around a model you can manipulate.`}>
  <section class="masthead">
    <p class="k k-c">{course.school} · {course.year} · {course.periodMinutes} minute periods</p>
    <h1>Advanced Biology</h1>
    <p class="lede">Ten units. Each standard opens with a question you can answer by moving something on the screen.</p>
  </section>

  <div class="ledger-head"><span class="k">The units, in sequence</span><span class="k">Progress on this device</span></div>
  <ol class="unit-ledger" aria-label="Units in sequence">
    {units.map((u) => {
      const central = u.standards.find((s) => s.central)!;
      return (
        <li>
          <a class="unit-row" href={url(`/unit/${u.nn}/`)} style={`--unit:${u.accent}`}>
            <span class="idx">{u.nn}</span>
            <span class="sw" aria-hidden="true"></span>
            <span class="u-title">{u.title}</span>
            <span class="u-meta">Central idea: {lower(central.title)}</span>
            <span class="u-read">{chapterLabel(u)}</span>
            <span class="sqs" role="img" aria-label={`${u.standards.length} standards`}>
              {u.standards.map((s) => <span class="sq" data-progress-dot={s.code}></span>)}
            </span>
          </a>
        </li>
      );
    })}
  </ol>

  <section class="doc">
    <p class="k k-c">Lab</p>
    <h2>Structures and simulations</h2>
    <p>Reusable models that the units draw on. The carbon allotropes gallery is the first.</p>
    <a class="action" href={url('/lab/')}>Open the lab</a>
  </section>
</Layout>
