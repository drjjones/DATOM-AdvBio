---
import Layout from '../../../layouts/Layout.astro';
import { units, sectionId, readingLabel, chaptersFor, type Unit } from '../../../lib/content';
import { url } from '../../../lib/url';

export function getStaticPaths() {
  return units.map((u) => ({ params: { nn: u.nn }, props: { unit: u } }));
}
const { unit } = Astro.props as { unit: Unit };
const central = unit.standards.find((s) => s.central)!;
const chs = chaptersFor(unit);
const chapterLabel = chs.length ? `Mader ${chs.length === 1 ? 'chapter' : 'chapters'} ${chs.map((c) => c.number).join(', ')}` : '';
const lower = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
---
<Layout title={`Unit ${unit.number}: ${unit.title}`} description={`${unit.title}. Five standards; the central idea is ${central.code}, ${central.title}.`} accent={unit.accent} unitLabel={`Unit ${unit.number}`}>
  <section class="masthead" data-section id="overview">
    <p class="k k-c">Unit {unit.nn} · {chapterLabel}</p>
    <h1>{unit.title}</h1>
    <p class="lede">Five standards. The central idea is {central.code}, {lower(central.title)}.</p>
    <p class="note">The interactive models for this unit are in production. The standards, readings, and checklists below are live.</p>
  </section>

  {unit.standards.map((s, i) => (
    <section class="std" data-section id={sectionId(s.code)}>
      <div class="drule" aria-hidden="true"></div>
      <header class="std-head">
        <div class="tags">
          <span class="status-box unit">{s.code}</span>
          {s.central && <span class="status-box signal">Central idea</span>}
        </div>
        <span class="k read">{readingLabel(s)}</span>
        <h2>{s.title}</h2>
      </header>
      <p>{s.description}</p>
      <div class="actions">
        <a class="btn" href={url(`/unit/${unit.nn}/standard/${i + 1}/`)}>Open standard</a>
        <button class="btn sec" type="button" data-present-section={sectionId(s.code)}>Present this section</button>
      </div>
    </section>
  ))}

  <section class="std" data-section id="exam">
    <div class="drule" aria-hidden="true"></div>
    <header class="std-head">
      <div class="tags"><span class="status-box">Unit exam</span></div>
      <span class="k read">100 points</span>
      <h2>How the unit exam is built</h2>
    </header>
    <p class="note">Every question is tagged to one of the five standards above.</p>
    <table class="ledger">
      <thead><tr><th scope="col">Part</th><th scope="col">Points</th><th scope="col">What it tests</th></tr></thead>
      <tbody>{unit.examBlueprint.map((r) => <tr><td>{r.part}</td><td>{r.points}</td><td class="body">{r.tests}</td></tr>)}</tbody>
    </table>
  </section>
</Layout>
