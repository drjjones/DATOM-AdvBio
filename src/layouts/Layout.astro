---
import '../styles/global.css';
import { url, basePath } from '../lib/url';
interface Props {
  title: string;
  description?: string;
  accent?: string;
  bodyClass?: string;
  noindex?: boolean;
  unitLabel?: string;
}
const { title, description = 'Interactive, unit by unit teaching site for Advanced Biology at Maret School.', accent, bodyClass = '', noindex = false, unitLabel } = Astro.props;
const path = Astro.url.pathname;
const route = path.startsWith(basePath) ? `/${path.slice(basePath.length)}` : path;
const isHome = route === '/';
const isLab = route.startsWith('/lab');
---
<!doctype html>
<html lang="en" data-env="dark" style={accent ? `--unit:${accent}` : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#101823" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="preload" href={url('/fonts/spectral-500-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/inter-400-700-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={url('/fonts/plexmono-500-normal.woff2')} as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (function () { try { var e = localStorage.getItem('ab:env'); if (e === 'paper') document.documentElement.removeAttribute('data-env'); else if (e === 'dark') document.documentElement.setAttribute('data-env', 'dark'); } catch (err) {} })();
    </script>
  </head>
  <body class={bodyClass}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="lh-header chrome">
      <span class="lh-drule" aria-hidden="true"></span>
      <div class="lh-in">
        <a class="mark-link" href={url('/')} aria-label="Advanced Biology, home">
          <img class="mark" src={url('/datom-mark.svg')} alt="" width="28" height="28" />
          <span class="wordmark" aria-hidden="true">DATOM</span>
          <span class="lh-sep" aria-hidden="true"></span>
          <span class="course">Advanced Biology</span>
        </a>
        <nav aria-label="Site">
          <a href={url('/')} aria-current={isHome ? 'page' : undefined}>Units</a>
          <a href={url('/lab/')} aria-current={isLab ? 'page' : undefined}>Lab</a>
          {unitLabel && <a href={path} aria-current="page">{unitLabel}</a>}
        </nav>
        <span class="spacer"></span>
        <div class="tools">
          <button class="btn sec" type="button" data-env-toggle aria-label="Switch to the paper environment"><span data-env-label>Paper</span></button>
          <button class="btn" type="button" data-present-toggle aria-pressed="false" title="Presentation mode (P)">Present</button>
        </div>
      </div>
      <span class="lh-drule" aria-hidden="true"></span>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer chrome">
      <div class="in">
        <span>Advanced Biology · Maret School · 2026-27</span>
        <span>Readings follow Mader and Windelspecht, <cite>Biology</cite>, 12th edition. Progress is stored on this device only.</span>
      </div>
    </footer>
    <div class="present-hud" role="group" aria-label="Presentation controls">
      <button class="btn sec icon" type="button" data-present-prev aria-label="Previous section"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg></button>
      <span class="counter" data-present-counter aria-live="polite"></span>
      <button class="btn sec icon" type="button" data-present-next aria-label="Next section"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
      <button class="btn" type="button" data-present-exit aria-label="Exit presentation mode">Exit</button>
    </div>
    <script>
      import '../scripts/shell';
    </script>
  </body>
</html>
